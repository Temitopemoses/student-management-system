# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS and Cookies)
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sms_db?schema=public"

# Authentication Secrets
JWT_SECRET=supersecret_dev_key_change_in_production_min32chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=sms_session
